{
  "name": "bacongrease",
  "version": "0.0.0",
  "private": true,
  "description": "Bacongrease — a personal component library and SCSS design system that greases the wheels of development.",
  "author": "Carter Bacon <carter@baconworks.dev>",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "yarn workspace @bacongrease/styles build && yarn workspace @bacongrease/components build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "sass": "^1.86.3",
    "storybook": "^8.6.12",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
