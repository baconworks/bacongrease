{
  "name": "@bacongrease/components",
  "version": "0.0.0",
  "description": "Bacongrease React component primitives — button, icon, modal, dropdown, and friends.",
  "author": "Carter Bacon <carter@baconworks.dev>",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-icons": ">=5"
  },
  "devDependencies": {
    "@bacongrease/styles": "workspace:*"
  }
}
